+++++ +++++             Cell 0 = 10 (Loop Counter)
[                       Loop to set cell values
    > +++++ ++          Cell 1 = 70
    > +++++ +++++       Cell 2 = 100
    > +++++ +++++ +     Cell 3 = 110
    > +                 Cell 4 = 10
    <<<< -              Decrement Cell 0
]
> +++++ +++++ +++ .     Cell 1: 70 + 13 = 83  -> 'S'
> - .                   Cell 2: 100 - 1 = 99  -> 'c'
> ----- - .             Cell 3: 110 - 6 = 104 -> 'h'
+++++ ++ .              Cell 3: 104 + 7 = 111 -> 'o'
.                       Cell 3: 111           -> 'o'
--- .                   Cell 3: 111 - 3 = 108 -> 'l'
> .                     Cell 4: 10            -> '\n'
